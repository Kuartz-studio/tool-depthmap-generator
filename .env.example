# Public URL of the site, used for the canonical URL, the sitemap and Open Graph tags.
# Optional on Vercel, where the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container of the hosted version (GA4 is set up inside it).
# GTM only loads on the production Vercel deployment. Leave empty to turn analytics off,
# and use your own container on a fork.
NEXT_PUBLIC_GTM_ID=GTM-WMDCM7W8
